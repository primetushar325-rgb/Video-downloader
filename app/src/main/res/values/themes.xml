<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VIDX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vidx_black</item>
        <item name="android:colorBackground">@color/vidx_black</item>
        <item name="android:statusBarColor">@color/vidx_black</item>
        <item name="android:navigationBarColor">@color/vidx_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/vidx_text_primary</item>
        <item name="android:textColorSecondary">@color/vidx_text_secondary</item>
        <item name="android:colorAccent">@color/vidx_red</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="VidxButton" parent="android:Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
